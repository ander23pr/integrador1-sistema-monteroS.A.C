# Variables de entorno para el proyecto Montero S.A.C
# Copia este archivo a .env y ajusta los valores para tu entorno local.

# Configuración de la base de datos MySQL
DB_URL=jdbc:mysql://localhost:3306/montero_db?useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=soldepiura

# Puerto del servidor (opcional)
SERVER_PORT=8080

